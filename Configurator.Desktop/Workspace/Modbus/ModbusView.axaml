<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:modbus="clr-namespace:Configurator.Desktop.Workspace.Modbus"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="Configurator.Desktop.Workspace.Modbus.ModbusView"
             x:DataType="modbus:ModbusViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#526173"/>
        </Style>
        <Style Selector="TextBox.compact">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="76"/>
        </Style>
        <Style Selector="Button.command">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style Selector="ToggleButton.coil">
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#B42318"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F4F7FA" RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D7DEE8"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="Modbus TCP" HorizontalAlignment="Center"/>
                    <TextBlock Classes="label" Text="{Binding LastUpdated, StringFormat='Обновлено: {0}'}" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Classes="panel" Padding="10,8" MinWidth="260">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="label" Text="Клиент"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding ClientState}"/>
                            <TextBlock Classes="label" Text="{Binding ClientMessage}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel" Padding="10,8" MinWidth="260">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="label" Text="Сервер"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding ServerState}"/>
                            <TextBlock Classes="label" Text="{Binding ServerMessage}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel" Padding="10,8" MinWidth="260">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="label" Text="Последняя ошибка"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding LastError}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="command" Content="Настройки" Command="{Binding OpenSettingsCommand}"/>
                    <Button Classes="command" Content="Start Both" Command="{Binding StartBothCommand}"/>
                    <Button Classes="command" Content="Stop Both" Command="{Binding StopBothCommand}"/>
                    <Button Classes="command" Content="Restart Both" Command="{Binding RestartBothCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16" RowDefinitions="*,180" RowSpacing="8">
        <TabControl Grid.Row="0" Padding="2">
            <TabItem Header="Клиент">
                <Grid ColumnDefinitions="320,*,360" ColumnSpacing="14" Margin="0,12,0,0">
                    <Border Grid.Column="0" Classes="panel">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="h2" Text="Настройки клиента"/>
                                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Включать в Both" IsChecked="{Binding ClientEnabled}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Host" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Classes="compact" Text="{Binding ClientHost, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Port" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Classes="compact" Text="{Binding ClientPort, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="UnitId" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Classes="compact" Text="{Binding ClientUnitId, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Poll, ms" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Classes="compact" Text="{Binding ClientPollIntervalMs, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Читать/писать Coils" IsChecked="{Binding ClientCoilsEnabled}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Coil start" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Classes="compact" Text="{Binding ClientCoilStartAddress, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="Coils" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Classes="compact" Text="{Binding ClientCoilCount, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Читать/писать Holding Registers" IsChecked="{Binding ClientHoldingRegistersEnabled}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Classes="label" Text="Register start" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Classes="compact" Text="{Binding ClientHoldingRegisterStartAddress, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="10" Grid.Column="0" Classes="label" Text="Registers" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Classes="compact" Text="{Binding ClientRegisterCount, Mode=TwoWay}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="command" Content="Start" Command="{Binding StartClientCommand}"/>
                                    <Button Classes="command" Content="Stop" Command="{Binding StopClientCommand}"/>
                                    <Button Classes="command" Content="Restart" Command="{Binding RestartClientCommand}"/>
                                </StackPanel>
                                <TextBlock Classes="label" Text="{Binding ClientLastUpdated, StringFormat='Snapshot: {0}'}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="14">
                        <Border Grid.Row="0" Classes="panel">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <TextBlock Classes="h2" Text="Coils"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ClientCoils}" IsEnabled="{Binding CanEditClientCoils}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="modbus:ModbusCoilRow">
                                                <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="6">
                                                    <Grid ColumnDefinitions="70,90,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Address}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <ToggleButton Grid.Column="1" Classes="coil" Content="{Binding ValueText}" IsChecked="{Binding Value, Mode=TwoWay}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="panel">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <TextBlock Classes="h2" Text="Holding Registers"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ClientRegisters}" IsEnabled="{Binding CanEditClientRegisters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="modbus:ModbusRegisterRow">
                                                <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="6">
                                                    <Grid ColumnDefinitions="70,120,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Address}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Classes="compact" Text="{Binding RawValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Grid.Column="2" Classes="error" Text="{Binding ErrorText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Classes="panel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Classes="h2" Text="Typed Registers"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ClientTypedRegisters}" IsEnabled="{Binding CanEditClientRegisters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="modbus:ModbusTypedRegisterRow">
                                            <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="6">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Classes="compact" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Сервер">
                <Grid ColumnDefinitions="320,*,360" ColumnSpacing="14" Margin="0,12,0,0">
                    <Border Grid.Column="0" Classes="panel">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="h2" Text="Настройки сервера"/>
                                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Включать в Both" IsChecked="{Binding ServerEnabled}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Bind" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Classes="compact" Text="{Binding ServerBindAddress, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Port" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Classes="compact" Text="{Binding ServerPort, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="UnitId" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Classes="compact" Text="{Binding ServerUnitId, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Poll, ms" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Classes="compact" Text="{Binding ServerPollIntervalMs, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Coils" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Classes="compact" Text="{Binding ServerCoilCount, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Registers" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Classes="compact" Text="{Binding ServerRegisterCount, Mode=TwoWay}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="command" Content="Start" Command="{Binding StartServerCommand}"/>
                                    <Button Classes="command" Content="Stop" Command="{Binding StopServerCommand}"/>
                                    <Button Classes="command" Content="Restart" Command="{Binding RestartServerCommand}"/>
                                </StackPanel>
                                <TextBlock Classes="label" Text="{Binding ServerLastUpdated, StringFormat='Snapshot: {0}'}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="14">
                        <Border Grid.Row="0" Classes="panel">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <TextBlock Classes="h2" Text="Coils"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ServerCoils}" IsEnabled="{Binding CanEditServerValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="modbus:ModbusCoilRow">
                                                <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="6">
                                                    <Grid ColumnDefinitions="70,90,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Address}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <ToggleButton Grid.Column="1" Classes="coil" Content="{Binding ValueText}" IsChecked="{Binding Value, Mode=TwoWay}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Classes="panel">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <TextBlock Classes="h2" Text="Holding Registers"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ServerRegisters}" IsEnabled="{Binding CanEditServerValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="modbus:ModbusRegisterRow">
                                                <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="6">
                                                    <Grid ColumnDefinitions="70,120,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Address}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Classes="compact" Text="{Binding RawValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Grid.Column="2" Classes="error" Text="{Binding ErrorText}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Classes="panel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Classes="h2" Text="Typed Registers"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ServerTypedRegisters}" IsEnabled="{Binding CanEditServerValues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="modbus:ModbusTypedRegisterRow">
                                            <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="6">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Classes="compact" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Classes="panel">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Classes="h2" Text="Events"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="modbus:ModbusEventRow">
                                <Border Height="22" ToolTip.Tip="{Binding Details}">
                                    <Grid ColumnDefinitions="70,120,70,*" ColumnSpacing="8">
                                        <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding TimeText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="12" Text="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="12" Text="{Binding Level}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" FontFamily="Consolas" FontSize="12" Text="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
