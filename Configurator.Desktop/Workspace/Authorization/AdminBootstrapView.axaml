<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Configurator.Desktop.Workspace.Authorization;assembly=Configurator.Desktop"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Configurator.Desktop.Workspace.Authorization.AdminBootstrapView"
             x:DataType="vm:AdminBootstrapViewModel">
    <Grid>
        <StackPanel Orientation="Vertical"
                    Margin="20"
                    Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <TextBlock Text="Administrator Bootstrap"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBox PlaceholderText="Username"
                     Text="{Binding Username}"/>
            <TextBox PlaceholderText="Password"
                     Text="{Binding Password}"
                     PasswordChar="●"/>
            <TextBox PlaceholderText="Confirm password"
                     Text="{Binding ConfirmPassword}"
                     PasswordChar="●"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#B3261E"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>
            <Button Content="Create administrator"
                    Command="{Binding BootstrapCommand}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</UserControl>
