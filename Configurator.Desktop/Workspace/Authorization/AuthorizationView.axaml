<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Configurator.Desktop.Workspace.Authorization.AuthorizationView"
			 xmlns:vm="clr-namespace:Configurator.Desktop.Workspace.Authorization;assembly=Configurator.Desktop"
			 x:DataType="vm:AuthorizationViewModel">
	<Grid>
		<StackPanel Orientation="Vertical" Margin="20" Width="300">
			<TextBlock Text="Вход в систему" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
			<TextBox Watermark="Имя пользователя" Text="{Binding Username}" Margin="0,0,0,5"/>
			<TextBox Watermark="Пароль" Text="{Binding Password}" PasswordChar="●" Margin="0,0,0,10"/>
			<Button Content="Войти" Command="{Binding AuthenticateCommand}"/>
		</StackPanel>
	</Grid>
</UserControl>
