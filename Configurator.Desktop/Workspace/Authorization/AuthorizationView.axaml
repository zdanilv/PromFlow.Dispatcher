<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Configurator.Desktop.Workspace.Authorization.AuthorizationView"
			 xmlns:vm="clr-namespace:Configurator.Desktop.Workspace.Authorization;assembly=Configurator.Desktop"
			 x:DataType="vm:AuthorizationViewModel">
	<Grid>
		<StackPanel Orientation="Vertical" Margin="20" Width="300" Spacing="6">
			<TextBlock Text="Вход в систему" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
			<TextBox PlaceholderText="Имя пользователя" Text="{Binding Username}"/>
			<TextBox PlaceholderText="Пароль" Text="{Binding Password}" PasswordChar="●"/>
			<CheckBox Content="Запомнить пароль"
					  IsChecked="{Binding RememberPassword}"/>
			<CheckBox Content="Автоматический вход"
					  IsChecked="{Binding AutoLogin}"
					  IsEnabled="{Binding CanUseAutoLogin}"/>
			<TextBlock Text="{Binding ErrorMessage}"
					   Foreground="#B3261E"
					   TextWrapping="Wrap"/>
			<Button Content="Войти" Command="{Binding AuthenticateCommand}"/>
		</StackPanel>
	</Grid>
</UserControl>
