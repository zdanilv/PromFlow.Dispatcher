<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:demo="clr-namespace:Configurator.Desktop.Workspace.ModbusDemo"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="650"
             x:Class="Configurator.Desktop.Workspace.ModbusDemo.ModbusDemoView"
             x:DataType="demo:ModbusDemoViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#526173"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Button.command">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F4F7FA" RowDefinitions="Auto,*" RowSpacing="14">
        <Border Grid.Row="0" Classes="panel" Margin="16,16,16,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="Modbus TCP Demo"/>
                    <TextBlock Classes="label" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <TextBlock Classes="label" Text="{Binding LastError}" TextWrapping="Wrap"/>
                    <TextBlock Classes="label"
                               IsVisible="{Binding IsWaitingForConnection}"
                               Text="Waiting for connection..."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="command" Content="Настройки" Command="{Binding OpenSettingsCommand}"/>
                    <Button Classes="command" Content="Start Server" Command="{Binding StartServerCommand}"/>
                    <Button Classes="command" Content="Start Client" Command="{Binding StartClientCommand}"/>
                    <Button Classes="command" Content="Stop" Command="{Binding StopCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="340,*,280" ColumnSpacing="14" Margin="16,0,16,16">
            <Border Grid.Column="0" Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Coil Binding"/>
                    <TextBlock Classes="label" Text="Toggle writes DemoButton to Coil[0]."/>
                    <ToggleButton MinHeight="48"
                                  HorizontalAlignment="Stretch"
                                  Content="{Binding DemoButtonText}"
                                  IsChecked="{Binding DemoButton, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Holding Register Binding"/>
                    <TextBlock Classes="label" Text="Save writes DemoInput to HoldingRegister[0]."/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Height="36"
                                 PlaceholderText="0..65535"
                                 Text="{Binding DemoInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1"
                                Classes="command"
                                Content="Save"
                                Command="{Binding SaveInputCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Image Binding"/>
                        <TextBlock Classes="label" Text="Visible when DemoImageVisible equals 1." TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="1"
                            BorderBrush="#D7DEE8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="#FAFBFC"
                            MinHeight="180">
                        <Image Width="120"
                               Height="120"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsDemoImageVisible}"
                               Source="avares://Configurator.Desktop/Assets/avalonia-logo.ico"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
