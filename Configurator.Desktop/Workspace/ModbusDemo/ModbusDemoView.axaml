<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:demo="clr-namespace:Configurator.Desktop.Workspace.ModbusDemo"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="Configurator.Desktop.Workspace.ModbusDemo.ModbusDemoView"
             x:DataType="demo:ModbusDemoViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#526173"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#B42318"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Button.command">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style Selector="Button.pulse">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.commandToggle">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.compact">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#F4F7FA" RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D7DEE8"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="ModbusDemo"/>
                    <TextBlock Classes="label" Text="Holding Registers 16384..16419"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <TextBlock Classes="error" Text="{Binding LastError}" TextWrapping="Wrap"/>
                    <TextBlock Classes="label"
                               IsVisible="{Binding IsWaitingForConnection}"
                               Text="Waiting for connection..."/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="command" Content="Настройки" Command="{Binding OpenSettingsCommand}"/>
                    <Button Classes="command" Content="Start Server" Command="{Binding StartServerCommand}"/>
                    <Button Classes="command" Content="Start Client" Command="{Binding StartClientCommand}"/>
                    <Button Classes="command" Content="Stop" Command="{Binding StopCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="16"
              ColumnDefinitions="1.05*,0.95*,1.25*"
              ColumnSpacing="14">
            <Border Grid.Column="0" Classes="panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Classes="h2" Text="Телеметрия"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TelemetryGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="demo:ModbusTelemetryRegisterGroup">
                                    <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding PointName}"/>
                                                <TextBlock Grid.Column="1"
                                                           Classes="label"
                                                           Text="{Binding AddressText, StringFormat='HR {0}'}"/>
                                            </Grid>
                                            <TextBlock Classes="label"
                                                       Text="{Binding RawValueText, StringFormat='Регистр: {0}'}"/>
                                            <ItemsControl ItemsSource="{Binding Bits}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="demo:ModbusTelemetryBitRow">
                                                        <Grid ColumnDefinitions="38,16,*,28" ColumnSpacing="8" MinHeight="24">
                                                            <TextBlock Classes="label"
                                                                       Text="{Binding BitText}"
                                                                       VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1"
                                                                    Width="10"
                                                                    Height="10"
                                                                    CornerRadius="5"
                                                                    Background="#D92D20"
                                                                    IsVisible="{Binding IsRedIndicatorVisible}"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Classes="value"
                                                                       Text="{Binding ValueText}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Classes="h2" Text="Команды"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CommandGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="demo:ModbusCommandRegisterGroup">
                                    <Border IsVisible="{Binding HasRows}"
                                            BorderBrush="#EDF1F5"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding PointName}"/>
                                                <TextBlock Grid.Column="1"
                                                           Classes="label"
                                                           Text="{Binding AddressText, StringFormat='HR {0}'}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="demo:ModbusCommandBitRow">
                                                        <Grid ColumnDefinitions="38,*" ColumnSpacing="8" MinHeight="40">
                                                            <TextBlock Classes="label"
                                                                       Text="{Binding BitText}"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    Classes="pulse"
                                                                    IsVisible="{Binding IsMomentaryButton}"
                                                                    Content="{Binding Name}"
                                                                    Command="{Binding PulseCommand}"
                                                                    IsEnabled="{Binding !IsWriting}"/>
                                                            <ToggleButton Grid.Column="1"
                                                                          Classes="commandToggle"
                                                                          IsVisible="{Binding IsToggleButton}"
                                                                          Content="{Binding Name}"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          IsEnabled="{Binding !IsWriting}"/>
                                                            <RadioButton Grid.Column="1"
                                                                         Classes="commandToggle"
                                                                         IsVisible="{Binding IsRadioButtonPulse}"
                                                                         Content="{Binding Name}"
                                                                         IsChecked="{Binding IsPulseActive, Mode=OneWay}"
                                                                         IsEnabled="{Binding !IsWriting}"/>
                                                            <CheckBox Grid.Column="1"
                                                                      IsVisible="{Binding IsCheckBox}"
                                                                      Content="{Binding Name}"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      IsEnabled="{Binding !IsWriting}"
                                                                      VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Classes="h2" Text="Изменяемые параметры" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="command"
                                Content="Считать значения"
                                Command="{Binding ReadParametersCommand}"/>
                        <Button Grid.Column="2"
                                Classes="command"
                                Content="Записать значения"
                                Command="{Binding WriteParametersCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ParameterRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="demo:ModbusParameterRow">
                                    <Border BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid ColumnDefinitions="76,*,88,220,70" ColumnSpacing="8">
                                            <TextBlock Classes="label"
                                                       Text="{Binding AddressText}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Classes="value"
                                                       Text="{Binding LastReadValueText}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="3"
                                                     Classes="compact"
                                                     IsVisible="{Binding IsTextBox}"
                                                     Text="{Binding EditValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Grid Grid.Column="3"
                                                  ColumnDefinitions="*,64"
                                                  ColumnSpacing="8"
                                                  IsVisible="{Binding IsSlider}">
                                                <Slider Minimum="{Binding SliderMinimum}"
                                                        Maximum="{Binding SliderMaximum}"
                                                        TickFrequency="1"
                                                        Value="{Binding SliderValue, Mode=TwoWay}"/>
                                                <TextBlock Grid.Column="1"
                                                           Classes="value"
                                                           Text="{Binding EditValueText}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Column="4"
                                                       Classes="error"
                                                       Text="{Binding ErrorText}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
