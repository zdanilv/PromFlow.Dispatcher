<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:Configurator.Desktop.Main"
             xmlns:vm="clr-namespace:Configurator.Desktop.Workspace.RouteMap.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="64"
             x:Class="Configurator.Desktop.Workspace.RouteMap.Panels.TopBarView"
             x:DataType="vm:TopBarViewModel">
    <UserControl.Styles>
        <Style Selector="ToggleButton.mode">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#59636E"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.mode:checked">
            <Setter Property="Background" Value="#003CA3"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.mode:pressed">
            <Setter Property="Background" Value="#8AB5FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.emergency">
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#FF2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.emergency:pointerover">
            <Setter Property="Background" Value="#FF8A8A"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <Style Selector="ToggleButton.emergency:checked">
            <Setter Property="Background" Value="#D10000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.emergency:pressed">
            <Setter Property="Background" Value="#D10000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.reset:pointerover">
            <Setter Property="Background" Value="#FFF78A"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <Style Selector="ToggleButton.reset:checked">
            <Setter Property="Background" Value="#D1C300"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <Style Selector="ToggleButton.reset:pressed">
            <Setter Property="Background" Value="#D1C300"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <!-- Fluent sets its checked brush directly on this template part. Keep the
        RouteMap action palette authoritative for the rendered surface. -->
        <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#003CA3"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.mode:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8AB5FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.emergency:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF8A8A"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <Style Selector="ToggleButton.emergency:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D10000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.emergency:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D10000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleButton.reset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFF78A"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <Style Selector="ToggleButton.reset:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D1C300"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <Style Selector="ToggleButton.reset:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D1C300"/>
            <Setter Property="Foreground" Value="#101820"/>
        </Style>
        <Style Selector="Button.emergency">
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#FF2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.admin-command">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#4E5A65"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip.Tip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#DCE9FB"/>
                <Setter Property="Foreground" Value="#173A66"/>
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#A9CAFA"/>
                <Setter Property="Foreground" Value="#173A66"/>
            </Style>
            <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="#003CA3"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#E2E6E9"/>
                <Setter Property="Foreground" Value="#626D78"/>
                <Setter Property="BorderBrush" Value="#CCD3D8"/>
            </Style>
            <Style Selector="^.sending">
                <Setter Property="AutomationProperties.ItemStatus" Value="Отправка команды"/>
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#C5DDFB"/>
                    <Setter Property="Foreground" Value="#173A66"/>
                    <Setter Property="BorderBrush" Value="#547DAE"/>
                </Style>
            </Style>
        </Style>
        <Style Selector="Button.settings">
            <Setter Property="MinWidth" Value="142"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#4E5A65"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.help">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button#HelpButton">
            <Setter Property="Background" Value="#003CA3"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#0A4DB5"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#002F80"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
        </Style>
        <Style Selector="Button#ExitButton">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#4E5A65"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#F2F4F5"
            BorderBrush="#D8DDE1"
            BorderThickness="0,0,0,1"
            MinHeight="64"
            Padding="16,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel x:Name="BrandPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border Background="#003CA3"
                        CornerRadius="3"
                        Padding="10,5">
                    <TextBlock Text="ПРОМ"
                               Foreground="#FFFFFF"
                               FontWeight="Bold"
                               FontSize="18"/>
                </Border>
                <TextBlock Text="Диспетчер"
                           VerticalAlignment="Center"
                           Foreground="#53606A"
                           FontSize="18"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        IsVisible="False"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="AutomaticButton"
                              IsVisible="False"
                              Classes="mode"
                              Content="{Binding AutomaticText}"
                              Background="{Binding AutomaticBackground}"
                              Foreground="{Binding AutomaticForeground}"
                              IsChecked="{Binding IsAutomaticMode}"
                              IsEnabled="{Binding IsAutomaticCommandEnabled}"/>
                <ToggleButton x:Name="ManualButton"
                              IsVisible="False"
                              Classes="mode"
                              Content="{Binding ManualText}"
                              Background="{Binding ManualBackground}"
                              Foreground="{Binding ManualForeground}"
                              IsChecked="{Binding IsManualMode}"
                              IsEnabled="{Binding IsManualCommandEnabled}"/>
            </StackPanel>

            <ScrollViewer x:Name="CommandScroll"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          BringIntoViewOnFocusChange="True"
                          AllowAutoHide="False"
                          Focusable="False">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <Button x:Name="UnloadButton"
                            Classes="admin-command"
                            Classes.sending="{Binding IsUnloadSending}"
                            Content="{Binding UnloadText}"
                            AutomationProperties.Name="{Binding UnloadText}"
                            Command="{Binding UnloadCommand}"
                            IsEnabled="{Binding IsUnloadEnabled}"
                            IsVisible="{Binding AreAdminCommandsVisible}"/>
                    <Button x:Name="RotationButton"
                            Classes="admin-command"
                            Classes.sending="{Binding IsRotationSending}"
                            Content="{Binding RotationText}"
                            AutomationProperties.Name="{Binding RotationText}"
                            Command="{Binding RotationCommand}"
                            IsEnabled="{Binding IsRotationEnabled}"
                            IsVisible="{Binding AreAdminCommandsVisible}"/>
                    <Button x:Name="LoadButton"
                            Classes="admin-command"
                            Classes.sending="{Binding IsLoadSending}"
                            Content="{Binding LoadText}"
                            AutomationProperties.Name="{Binding LoadText}"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsLoadEnabled}"
                            IsVisible="{Binding AreAdminCommandsVisible}"/>
                    <ToggleButton x:Name="ResetButton"
                                  Classes="emergency reset"
                                  Content="{Binding ResetText}"
                                  Background="{Binding ResetBackground}"
                                  BorderBrush="#CCD3D8"
                                  Foreground="{Binding ResetForeground}"
                                  IsChecked="{Binding IsResetActive, Mode=OneWay}"
                                  IsEnabled="{Binding IsResetCommandEnabled}"
                                  PointerEntered="Button_PointerEntered"
                                  PointerExited="Button_PointerExited"
                                  Command="{Binding ResetCommand}"/>
                    <ToggleButton x:Name="EmergencyButton"
                                  Classes="emergency"
                                  Content="{Binding EmergencyText}"
                                  Background="{Binding EmergencyBackground}"
                                  BorderBrush="#CCD3D8"
                                  Foreground="#FFFFFF"
                                  IsChecked="{Binding HasEmergency}"
                                  IsEnabled="{Binding IsEmergencyCommandEnabled}"
                                  PointerEntered="Button_PointerEntered"
                                  PointerExited="Button_PointerExited"
                                  Command="{Binding EmergencyCommand}"/>
                    <Button Classes="settings"
                            Content="НАСТРОЙКИ"
                            IsVisible="{Binding IsSettingsVisible}"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="2"
                        Margin="16,0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Button x:Name="HelpButton"
                        Classes="help"
                        Content="ПОМОЩЬ"
                        Command="{Binding OpenHelpCommand}"/>
                <Button x:Name="ExitButton"
                        Classes="help"
                        Content="ВЫХОД"
                        IsVisible="{Binding StartedFullScreen, RelativeSource={RelativeSource AncestorType=main:MainWindow}, FallbackValue=False}"
                        Click="ExitButton_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
