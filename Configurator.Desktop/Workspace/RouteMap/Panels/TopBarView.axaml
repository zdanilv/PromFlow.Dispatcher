<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Configurator.Desktop.Workspace.RouteMap.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="64"
             x:Class="Configurator.Desktop.Workspace.RouteMap.Panels.TopBarView"
             x:DataType="vm:TopBarViewModel">
    <UserControl.Styles>
        <Style Selector="ToggleButton.mode">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#59636E"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.emergency">
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#D95D4E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D95D4E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.emergency">
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#D95D4E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D95D4E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.settings">
            <Setter Property="MinWidth" Value="142"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#4E5A65"/>
            <Setter Property="BorderBrush" Value="#CCD3D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#F2F4F5"
            BorderBrush="#D8DDE1"
            BorderThickness="0,0,0,1"
            MinHeight="64"
            Padding="16,8">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="12">
            <Border Background="#2C78C6"
                    CornerRadius="3"
                    Padding="10,5">
                <TextBlock Text="КИП"
                           Foreground="#FFFFFF"
                           FontWeight="Bold"
                           FontSize="18"/>
            </Border>
            <TextBlock Text="Сервис"
                       VerticalAlignment="Center"
                       Foreground="#53606A"
                       FontSize="18"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="28,0,0,0">
            <ToggleButton x:Name="AutomaticButton"
                          Classes="mode"
                          Content="{Binding AutomaticText}"
                          Background="{Binding AutomaticBackground}"
                          Foreground="{Binding AutomaticForeground}"
                          IsChecked="{Binding IsAutomaticMode}"
                          IsEnabled="{Binding IsAutomaticCommandEnabled}"
                          PointerEntered="Button_PointerEntered"
                          PointerExited="Button_PointerExited"
                          Command="{Binding SwitchToAutomaticCommand}"/>
            <ToggleButton x:Name="ManualButton"
                          Classes="mode"
                          Content="{Binding ManualText}"
                          Background="{Binding ManualBackground}"
                          Foreground="{Binding ManualForeground}"
                          IsChecked="{Binding IsManualMode}"
                          IsEnabled="{Binding IsManualCommandEnabled}"
                          PointerEntered="Button_PointerEntered"
                          PointerExited="Button_PointerExited"
                          Command="{Binding SwitchToManualCommand}"/>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
            <ToggleButton x:Name="ResetButton"
                          Classes="emergency"
                          Content="{Binding ResetText}"
                          Background="{Binding ResetBackground}"
                          BorderBrush="{Binding ResetBackground}"
                          Foreground="{Binding ResetForeground}"
                          IsChecked="{Binding IsResetActive, Mode=OneWay}"
                          IsEnabled="{Binding IsResetCommandEnabled}"
                          PointerEntered="Button_PointerEntered"
                          PointerExited="Button_PointerExited"
                          Command="{Binding ResetCommand}"/>
            <ToggleButton x:Name="EmergencyButton"
                          Classes="emergency"
                          Content="{Binding EmergencyText}"
                          Background="{Binding EmergencyBackground}"
                          BorderBrush="{Binding EmergencyBackground}"
                          Foreground="{Binding EmergencyForeground}"
                          IsChecked="{Binding HasEmergency}"
                          IsEnabled="{Binding IsEmergencyCommandEnabled}"
                          PointerEntered="Button_PointerEntered"
                          PointerExited="Button_PointerExited"
                          Command="{Binding EmergencyCommand}"/>
            <Button Classes="settings"
                    Content="НАСТРОЙКИ"
                    IsVisible="{Binding IsSettingsVisible}"
                    Command="{Binding OpenSettingsCommand}"/>
        </StackPanel>

        <TextBlock Grid.Column="3"
                   Height="32"
                   Margin="16,0"
                   VerticalAlignment="Center"
                   Text="8 800 700 98 82"
                   Foreground="#69747E"
                   FontSize="13"
                   TextAlignment="Center"/>

    </Grid>
    </Border>
</UserControl>
