<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Configurator.Desktop.Workspace.RouteMap.ViewModels"
             xmlns:models="clr-namespace:Configurator.Desktop.Workspace.RouteMap.Models"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="720"
             x:Class="Configurator.Desktop.Workspace.RouteMap.Panels.RequestsPanelView"
             x:DataType="vm:RequestsPanelViewModel">
    <Border Background="#F2F4F5"
            BorderBrush="#D8DDE1"
            BorderThickness="1,0,0,0"
            Padding="16,10">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
              Margin="0">
            <TabControl Grid.Row="0"
                        MinHeight="44">
                <TabItem Header="Заявки"/>
                <TabItem Header="История заявок"/>
            </TabControl>

            <Button Grid.Row="1"
                    Content="{Binding StartQueueText}"
                    Command="{Binding StartQueueCommand}"
                    Height="34"
                    Margin="0,6,0,8"
                    HorizontalAlignment="Stretch"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="18"
                        Margin="0,2,0,12">
                <TextBlock Text="АВТОМАТ"
                           Foreground="#69747E"
                           VerticalAlignment="Center"/>
                <RadioButton IsChecked="{Binding IsAutomatic}"/>
                <TextBlock Text="РУЧНОЙ"
                           Foreground="#69747E"
                           VerticalAlignment="Center"/>
                <RadioButton IsChecked="{Binding IsManual}"/>
            </StackPanel>

            <Grid Grid.Row="3"
                  ColumnDefinitions="42,*,70,78,78"
                  Margin="0,0,0,4">
                <TextBlock Text="№" FontWeight="SemiBold" Foreground="#6D7680"/>
                <TextBlock Grid.Column="1" Text="Рецепт" FontWeight="SemiBold" Foreground="#6D7680"/>
                <TextBlock Grid.Column="2" Text="Объем" FontWeight="SemiBold" Foreground="#6D7680"/>
                <TextBlock Grid.Column="3" Text="Загрузка" FontWeight="SemiBold" Foreground="#6D7680"/>
                <TextBlock Grid.Column="4" Text="Выгрузка" FontWeight="SemiBold" Foreground="#6D7680"/>
            </Grid>

            <Border Grid.Row="4"
                    BorderBrush="#DCE1E5"
                    BorderThickness="0,1,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:RequestItem" x:DataType="models:RequestItem">
                                <Grid ColumnDefinitions="42,*,70,78,78"
                                      MinHeight="30">
                                    <TextBlock Text="{Binding Number}"
                                               VerticalAlignment="Center"
                                               Foreground="#59636E"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Recipe}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#48525C"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Volume}"
                                               VerticalAlignment="Center"
                                               Foreground="#59636E"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Loading}"
                                               VerticalAlignment="Center"
                                               Foreground="#59636E"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Unloading}"
                                               VerticalAlignment="Center"
                                               Foreground="#59636E"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Expander Grid.Row="5"
                      Header="Шаблоны заявок"
                      Margin="0,10,0,8"
                      IsExpanded="False">
                <ItemsControl ItemsSource="{Binding RequestTemplates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:RequestTemplateItem" x:DataType="models:RequestTemplateItem">
                            <TextBlock Text="{Binding Title}"
                                       Margin="0,3"
                                       Foreground="#59636E"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Grid Grid.Row="6"
                  ColumnDefinitions="44,*"
                  ColumnSpacing="8">
                <Button Content="+"
                        FontSize="22"
                        Command="{Binding AddRequestCommand}"/>
                <Button Grid.Column="1"
                        Content="СТОП"
                        Command="{Binding StopQueueCommand}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
