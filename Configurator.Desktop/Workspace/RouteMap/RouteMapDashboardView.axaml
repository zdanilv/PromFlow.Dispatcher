<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Configurator.Desktop.Workspace.RouteMap.ViewModels"
             xmlns:controls="clr-namespace:Configurator.Desktop.Workspace.RouteMap.Controls"
             xmlns:panels="clr-namespace:Configurator.Desktop.Workspace.RouteMap.Panels"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="860"
             x:Class="Configurator.Desktop.Workspace.RouteMap.RouteMapDashboardView"
             x:DataType="vm:RouteMapDashboardViewModel">
    <Grid RowDefinitions="64,*"
           Background="#F2F4F5">
        <panels:TopBarView Grid.Row="0"
                           DataContext="{Binding TopBar}"/>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0">
                <Border Background="#F2F4F5">
                    <Grid>
                        <controls:RouteMapControl Definition="{Binding Definition}"
                                                  RuntimeState="{Binding RuntimeState}"
                                                  SelectedObjectId="{Binding SelectedObjectId, Mode=TwoWay}"
                                                  NodeRoleStates="{Binding NodeRoleStates}"
                                                  ToggleNodeTargetCommand="{Binding ToggleNodeTargetCommand}"
                                                  ToggleNodeLoaderCommand="{Binding ToggleNodeLoaderCommand}"
                                                  AreCommandsEnabled="{Binding RuntimeState.IsConnectionAvailable}"/>
                        <panels:RouteMapAttachedCardsLayer Definition="{Binding Definition}"
                                                           Cards="{Binding MapEquipmentCards}"
                                                           ClipToBounds="False"/>
                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="16"
                                    Spacing="8"
                                    IsHitTestVisible="False">
                            <Border x:Name="ConnectionStatusOverlay"
                                    Padding="10,6"
                                    Background="#FFFFFF"
                                    BorderBrush="#DDE2E6"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    IsVisible="{Binding IsConnectionStatusVisible}">
                                <TextBlock Text="{Binding ConnectionStatusText}"
                                           Foreground="#9CA4AA"
                                           FontSize="12"/>
                            </Border>
                            <Border x:Name="RouteMapStateLegendOverlay"
                                    Padding="10,8"
                                    Background="#FFFFFF"
                                    BorderBrush="#DDE2E6"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Обозначения"
                                               Foreground="#44505C"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <StackPanel Spacing="3" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="SelectedNode"/>
                                            <TextBlock Text="Выбранный узел" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="HoveredNode"/>
                                            <TextBlock Text="Наведённый узел" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="ActiveNode"/>
                                            <TextBlock Text="Активный узел" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="TargetNode"/>
                                            <TextBlock Text="Узел — точка отправки" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="LoaderNode"/>
                                            <TextBlock Text="Узел — точка возврата" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="FaultNode"/>
                                            <TextBlock Text="Авария узла" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="OfflineNode"/>
                                            <TextBlock Text="Узел не в сети" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="ActiveSegment"/>
                                            <TextBlock Text="Активная линия" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="FaultSegment"/>
                                            <TextBlock Text="Авария линии" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:RouteMapLegendGlyph Width="40" Height="30" Definition="{Binding Definition}" Kind="OfflineSegment"/>
                                            <TextBlock Text="Линия не в сети" Foreground="#65717D" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border x:Name="SelectedObjectOverlay"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,335,16"
                                Padding="10,6"
                                Background="#FFFFFF"
                                BorderBrush="#DDE2E6"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="SelectedObjectText"
                                       Foreground="#65717D"
                                       FontSize="12"><Run Text="Выбран - "/><Run Text="{Binding SelectedObjectTitle}"/></TextBlock>
                        </Border>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="16"
                                Padding="10,6"
                                Background="#FFF4F2"
                                BorderBrush="#F4B8B0"
                                BorderThickness="1"
                                CornerRadius="4"
                                IsVisible="{Binding HasCommandError}">
                            <TextBlock Text="{Binding CommandErrorMessage}"
                                       Foreground="#A22F2F"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxWidth="520"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <panels:NotificationsPanelView Grid.Column="1"
                                           IsVisible="True"
                                           DataContext="{Binding NotificationsPanel}"/>
        </Grid>
    </Grid>
</UserControl>
