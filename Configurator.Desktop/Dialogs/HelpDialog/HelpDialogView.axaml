<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Configurator.Desktop.Dialogs.HelpDialog"
             x:Class="Configurator.Desktop.Dialogs.HelpDialog.HelpDialogView"
             x:DataType="vm:HelpDialogViewModel">
    <UserControl.Styles>
        <Style Selector="Button.website-link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#003CA3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Width="380"
                Margin="24"
                Spacing="16">
        <TextBlock Text="Помощь"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#44505C"/>
        <ScrollViewer MaxHeight="420"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Contacts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HelpContactViewModel">
                        <Grid Margin="0,0,0,10"
                              ColumnDefinitions="120,*">
                            <TextBlock Text="{Binding Label}"
                                       Foreground="#65717D"/>
                            <TextBlock Grid.Column="1"
                                       IsVisible="{Binding IsPlainText}"
                                       Text="{Binding Value}"
                                       TextWrapping="Wrap"
                                       Foreground="#44505C"/>
                            <Button Grid.Column="1"
                                    IsVisible="{Binding IsLink}"
                                    Classes="website-link"
                                    Command="{Binding OpenLinkCommand}">
                                <TextBlock Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           TextDecorations="Underline"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock IsVisible="{Binding HasNoContacts}"
                   Text="Контакты не настроены."
                   Foreground="#65717D"/>
        <Button Content="Закрыть"
                HorizontalAlignment="Right"
                MinWidth="96"
                Command="{Binding CloseCommand}"/>
    </StackPanel>
</UserControl>
