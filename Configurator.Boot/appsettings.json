{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Avalonia": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]

  },
  "RouteMapRuntime": {
    "SignalSource": "Mock",
    "StaleAfterMs": 1500
  },
  "Authentication": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "MinimumPasswordLength": 12,
    "RequireDigit": true,
    "RequireUppercase": true,
    "RequireLowercase": true
  },
  "Modbus": {
    "AutostartOnWorkspaceOpen": false,
    "StartupMode": "None",
    "WriteConfirmationTimeoutMs": 2000,
    "Client": {
