      "Port": 502,
      "UnitId": 1,
      "PollIntervalMs": 500,
      "CoilsEnabled": true,
      "HoldingRegistersEnabled": true,
      "CoilStartAddress": 0,
      "HoldingRegisterStartAddress": 0,
      "CoilCount": 10,
      "RegisterCount": 20
