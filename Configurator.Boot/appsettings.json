  "OpcUa": {
    "AutostartOnWorkspaceOpen": false,
    "StartupMode": "None",
    "Client": {
      "Enabled": true,
      "ApplicationName": "DekstopTemplate OPC UA Client",
      "ApplicationUri": "urn:localhost:DekstopTemplate:OpcUa:Client",
      "ProductUri": "urn:DekstopTemplate",
      "EndpointUrl": "opc.tcp://localhost:4840",
      "SessionTimeoutMilliseconds": 60000,
      "ConnectTimeoutMilliseconds": 30000,
      "ReconnectPeriodMilliseconds": 5000,
      "SubscriptionPublishingIntervalMilliseconds": 1000,
      "CommandWriteIntervalMilliseconds": 3000
    },
    "Server": {
      "Enabled": true,
      "DemoTelemetryEnabled": true,
      "ApplicationName": "DekstopTemplate OPC UA Server",
      "ApplicationUri": "urn:localhost:DekstopTemplate:OpcUa:Server",
      "ProductUri": "urn:DekstopTemplate",
      "EndpointUrl": "opc.tcp://localhost:4840",
      "TelemetryUpdateIntervalMilliseconds": 1000
    },
    "Security": {
      "Mode": "None",
      "Authentication": {
        "Mode": "Anonymous"
      },
      "Certificates": {
        "Enabled": false
      }
    },
    "Nodes": {
      "NamespaceUri": "urn:Configurator:OpcUa:Demo",
      "DeviceIdentifier": "DemoDevice",
      "TelemetryFolderIdentifier": "DemoDevice/Telemetry",
      "CommandsFolderIdentifier": "DemoDevice/Commands",
      "IsRunningIdentifier": "DemoDevice/Telemetry/IsRunning",
      "CounterIdentifier": "DemoDevice/Telemetry/Counter",
      "ServerMessageIdentifier": "DemoDevice/Telemetry/ServerMessage",
      "RequestedBoolIdentifier": "DemoDevice/Commands/RequestedBool",
      "RequestedIntIdentifier": "DemoDevice/Commands/RequestedInt",
      "RequestedTextIdentifier": "DemoDevice/Commands/RequestedText"
    }
  },
  "WindowSettings": {
    "Width": 1200,
    "Height": 800,
    "IsFullScreen": false
  }
}
